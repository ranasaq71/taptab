# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public site address, used in tag links: https://taptab.com/t/CODE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Demo requests are emailed to LEADS_TO.
RESEND_API_KEY=
EMAIL_FROM="TapTab <hello@brandrise.us>"
LEADS_TO=brandrisellc@gmail.com

# Google Business Profile (AI review replies). OAuth client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Protects the daily review sync (Vercel Cron sends it automatically)
CRON_SECRET=
